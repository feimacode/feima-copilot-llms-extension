# ── node_modules ──
# vsce packages production dependencies from node_modules. We exclude ONLY the
# platform-specific CLI binary packages (~600MB combined) — participants resolve
# the user's locally-installed CLI via PATH/settings (feima.agents.*.binaryPath),
# so bundled binaries are not needed. Everything else (the JS SDK wrappers,
# koffi, zod, vscode-jsonrpc) is required at runtime and stays included.
node_modules/@github/copilot-linux-x64/
node_modules/@github/copilot-linux-arm64/
node_modules/@github/copilot-linuxmusl-x64/
node_modules/@github/copilot-linuxmusl-arm64/
node_modules/@github/copilot-darwin-arm64/
node_modules/@github/copilot-darwin-x64/
node_modules/@github/copilot-win32-x64/
node_modules/@github/copilot-win32-arm64/
node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/
node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64/
node_modules/@anthropic-ai/claude-agent-sdk-linux-x64-musl/
node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64-musl/
node_modules/@anthropic-ai/claude-agent-sdk-darwin-arm64/
node_modules/@anthropic-ai/claude-agent-sdk-darwin-x64/
node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/
node_modules/@anthropic-ai/claude-agent-sdk-win32-arm64/
# Unused transitive dependency (11MB, only referenced via type-only imports)
node_modules/@anthropic-ai/sdk/
# js-tiktoken is bundled into dist/extension.js by esbuild; the node_modules
# copy (~12MB) is never required at runtime.
node_modules/js-tiktoken/
**/.vscode/**
**/.github/**
**/test/**
**/.git/**
.claude/**
docs/**
docs-dist/**
